# Prangon Lite — environment template
# Copy to .env and fill in. Commit .env.example, never .env.

# Lite Supabase project (a NEW project — not the original Prangon one)
VITE_SUPABASE_URL=https://YOUR-LITE-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-lite-anon-key
VITE_SUPABASE_PROJECT_ID=your-lite-project-ref

# Demo mode
VITE_DEMO_PASSWORD=prangon-lite-demo
VITE_SHOW_DEMO_SWITCHER=true

# Optional media uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
